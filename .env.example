# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# GitHub token used by the copilot provider (ai.api_key_env: GITHUB_TOKEN).
# Optional: as-docs auto-discovers credentials in this priority order:
#   1. Env var named by ai.api_key_env (below)
#   2. GH_TOKEN env var
#   3. `gh auth token` (VS Code GitHub extension / GitHub CLI)
# Only set this if none of the above auto-sources apply.
GITHUB_TOKEN=

# If you switch ai.provider to anthropic in the future:
# ANTHROPIC_API_KEY=
