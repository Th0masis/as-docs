# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# GitHub token used by the copilot provider (ai.api_key_env: GITHUB_TOKEN)
# Minimum required scopes: none for GitHub Models endpoint;
# for Copilot API endpoints: copilot scope
GITHUB_TOKEN=

# If you switch ai.provider to anthropic in the future:
# ANTHROPIC_API_KEY=
