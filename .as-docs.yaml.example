project:
  name: "MyMachineProject"
  as_version: "4.10"
  root: "."                         # relative to this config file
  language: "en"                    # documentation output language

scanner:
  active_configuration: "Config1"   # which Physical config to parse
                                    # default: first found alphabetically
  ignore_dirs:                      # always excluded from scanning
    - Temp
    - Binaries
    - Diagnosis
  scan_libraries: true              # scan Logical/Libraries/ for custom lib ST code
  external_lib_prefixes:            # known precompiled prefixes → skip as external
    - "Mp"
    - "Mc"
    - "ACP10"
    - "Ar"
  recursive_packages: true          # recursively scan nested Package.pkg hierarchies (AS6+)
  max_recursion_depth: 10           # prevent runaway recursion in circular/deep package trees

ai:
  enabled: true
  provider: "copilot"             # copilot | anthropic
  model: "gpt-5-mini"
  api_base_url: ""                # optional: custom OpenAI/Azure endpoint via SDK provider config
  api_key_env: "GITHUB_TOKEN"
  timeout_seconds: 60
  max_retries: 3
  cache_dir: ".as-docs-cache"       # gitignored

server:
  mode: "stdio"                     # stdio | http
  port: 8765
  host: "127.0.0.1"                 # use 0.0.0.0 for team-shared remote

output:
  docs_dir: "docs/as-docs"
  formats:
    - markdown
    - json
    - llms.txt
  mermaid: true
  default_level: 3

git:
  hook_enabled: false               # set true after as-docs install-hook
  auto_level: 2                     # level to regenerate on commit

# Optional: Use as-cli for project discovery
# Requires: as-cli installed and in PATH (see https://github.com/br-automation-com/as-cli)
# 
# When enabled, as-docs uses as-cli logical_list and symbol_search commands
# for more accurate project discovery (catches nested packages, implicit programs).
# Falls back gracefully to filesystem scanning if as-cli is unavailable.
as_cli:
  enabled: false                    # Set to true if as-cli is installed and you want to use it
  path: "as-cli"                    # Path to as-cli executable (auto-detect from PATH by default)
  timeout_ms: 30000                 # Timeout per as-cli command (milliseconds)
  strict: false                     # If true, fail on as-cli errors; if false, fall back to filesystem
  use_commands:                     # Which as-cli commands to use
    - logical_list                  # Module/task/program hierarchy
    - symbol_search                 # All symbols in project
